# ========== LLM(千问 DashScope,OpenAI 兼容协议) ==========
# 阿里云百炼 API Key,在 https://bailian.console.aliyun.com 申请(以 sk- 开头)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DashScope OpenAI 兼容端点(一般无需改动)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# qwen-plus(性价比)/ qwen-max(更强)/ qwen-turbo(更快更省)
DASHSCOPE_MODEL=qwen-plus

# ========== 岗位审核(/review 页口令,官方侧配置) ==========
REVIEW_PASSPHRASE=请改成你自己的口令

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8000

# ========== 数据库(默认 SQLite,生产可切 PostgreSQL) ==========
DATABASE_URL=sqlite:///./interview.db

# ========== 前端 CORS(允许跨域来源,逗号分隔) ==========
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
